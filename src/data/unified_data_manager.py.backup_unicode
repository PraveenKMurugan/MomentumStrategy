        start_date='2020-01-01',
        max_workers=4
    )
    
    print(f"\nDownload Stats:")
    for key, value in stats.items():
        print(f"  {key}: {value}")
    
    # System health
    health = manager.get_system_health()
    print(f"\nSystem Health:")
    for key, value in health.items():
        print(f"  {key}: {value}")
    
    manager.close()

